<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- OpenGL is called through unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The shaders are built into the executable and read with GetManifestResourceStream("cube.vert"). -->
  <ItemGroup>
    <None Remove="Shaders\**" />
    <EmbeddedResource Include="Shaders\**" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
